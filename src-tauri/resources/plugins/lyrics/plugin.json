{
  "$schema": "../plugin.schema.json",
  "id": "com.window-hub.lyrics",
  "name": "歌词",
  "version": "1.5.0",
  "official": true,
  "logo": "icon.svg",
  "description": "折叠岛栏 DWM 映射网易云桌面歌词；合格截屏作兜底。下拉可切歌 / 暂停 / 打开网易云。",
  "entry": {
    "shortcuts": "shortcuts.html",
    "panel": "panel.html"
  },
  "slots": {
    "shortcuts": {
      "icon": "icon.svg",
      "label": "歌词",
      "order": 8,
      "action": "command"
    },
    "island.bar": {
      "order": 10
    },
    "island.panel": {
      "defaultSize": { "w": 380, "h": 220 },
      "excludeFromPullContent": false
    }
  },
  "settings": [
    {
      "key": "requireDesktopLyrics",
      "type": "boolean",
      "label": "仅桌面歌词开启时占岛栏",
      "description": "未开网易云桌面歌词时清空岛栏，让位下一顺位（如天气）",
      "default": true
    },
    {
      "key": "showWhenIdle",
      "type": "boolean",
      "label": "未播放/未开桌面歌词时仍提示",
      "description": "关闭则直接让位天气等",
      "default": false
    },
    {
      "key": "preferLyric",
      "type": "boolean",
      "label": "优先显示歌词镜像",
      "description": "桌面歌词开着时优先贴镜像；截图未就绪时先显示歌名",
      "default": true
    },
    {
      "key": "mirrorOffsetY",
      "type": "number",
      "label": "歌词垂直位置",
      "description": "只上下挪位置。按当前显示器记忆，接扩展屏后自动恢复",
      "default": 0,
      "min": -12,
      "max": 12,
      "step": 1
    },
    {
      "key": "mirrorScale",
      "type": "number",
      "label": "歌词显示大小",
      "description": "缩放百分比。与垂直位置分开，并按当前显示器分别记忆",
      "default": 100,
      "min": 50,
      "max": 150,
      "step": 5
    }
  ],
  "capabilities": ["storage", "island.panel", "island.bar", "shortcuts"]
}
