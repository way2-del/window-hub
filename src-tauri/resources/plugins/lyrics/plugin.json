{
  "$schema": "../plugin.schema.json",
  "id": "com.window-hub.lyrics",
  "name": "歌词",
  "version": "1.4.1",
  "official": true,
  "logo": "icon.svg",
  "description": "镜像网易云桌面歌词到灵动岛（缩小贴上，对齐 MyDockFinder）；下拉可切歌 / 暂停 / 打开网易云。",
  "entry": {
    "shortcuts": "shortcuts.html",
    "panel": "panel.html"
  },
  "slots": {
    "shortcuts": {
      "icon": "icon.svg",
      "label": "歌词",
      "order": 8,
      "action": "command"
    },
    "island.bar": {
      "order": 10
    },
    "island.panel": {
      "defaultSize": { "w": 380, "h": 196 },
      "excludeFromPullContent": false
    }
  },
  "settings": [
    {
      "key": "requireDesktopLyrics",
      "type": "boolean",
      "label": "仅桌面歌词开启时占岛栏",
      "description": "未开网易云桌面歌词时清空岛栏，让位下一顺位（如天气）",
      "default": true
    },
    {
      "key": "showWhenIdle",
      "type": "boolean",
      "label": "未播放/未开桌面歌词时仍提示",
      "description": "关闭则直接让位天气等",
      "default": false
    },
    {
      "key": "preferLyric",
      "type": "boolean",
      "label": "优先显示歌词镜像",
      "description": "桌面歌词开着时优先贴镜像；截图未就绪时先显示歌名",
      "default": true
    }
  ],
  "capabilities": ["storage", "island.panel", "island.bar", "shortcuts"]
}
