{
  "$schema": "../plugin.schema.json",
  "id": "com.window-hub.file-search",
  "name": "文件搜索",
  "version": "1.3.1",
  "official": true,
  "logo": "icon.svg",
  "description": "情景临时：Alt+空格先激活搜索栏；回车（可空）再展开下拉（Everything）。搜索结果左侧按类型/后缀过滤。需本机已运行 Everything。",
  "entry": {
    "panel": "panel.html"
  },
  "slots": {
    "island.scenario": {
      "order": 20
    },
    "island.bar": {
      "order": 20,
      "excludeFromBarResident": true
    },
    "island.panel": {
      "defaultSize": { "w": 560, "h": 280 },
      "excludeFromPullContent": true
    }
  },
  "capabilities": [
    "storage",
    "island.panel",
    "island.bar",
    "island.scenario",
    "everything.search"
  ]
}
