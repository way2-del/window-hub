{
  "$schema": "../plugin.schema.json",
  "id": "com.window-hub.now-playing",
  "name": "正在播放",
  "version": "1.2.3",
  "official": true,
  "logo": "icon.svg",
  "description": "情景临时：本机 Now Playing 服务正常且有曲目时暂代岛栏歌词与下拉播放器；停播或服务关闭后自动归还。设置中可绑定托盘，面板右下角打开对应应用。",
  "homepage": "https://github.com/Widdit/now-playing-service",
  "entry": {
    "shortcuts": "shortcuts.html",
    "panel": "panel.html"
  },
  "slots": {
    "shortcuts": {
      "icon": "icon.svg",
      "label": "正在播放",
      "order": 8,
      "action": "command",
      "manage": "none"
    },
    "island.scenario": {
      "order": 10
    },
    "island.bar": {
      "order": 10,
      "adaptiveWidth": true,
      "minWidth": 260,
      "maxWidth": 520,
      "excludeFromBarResident": true
    },
    "island.panel": {
      "defaultSize": { "w": 400, "h": 200 },
      "excludeFromPullContent": true
    }
  },
  "settings": [
    {
      "key": "apiBase",
      "type": "string",
      "label": "Now Playing API 地址",
      "description": "本机服务根地址（默认 http://127.0.0.1:9863，见软件「API 接口」页）",
      "default": "http://127.0.0.1:9863",
      "maxLength": 128
    },
    {
      "key": "pollMs",
      "type": "select",
      "label": "刷新间隔",
      "default": 1200,
      "options": [
        { "value": 500, "label": "0.5 秒" },
        { "value": 800, "label": "0.8 秒" },
        { "value": 1200, "label": "1.2 秒" },
        { "value": 2000, "label": "2 秒" }
      ]
    },
    {
      "key": "barMode",
      "type": "select",
      "label": "岛栏显示",
      "default": "lyric",
      "options": [
        { "value": "lyric", "label": "当前歌词" },
        { "value": "title", "label": "歌名 · 歌手" },
        { "value": "both", "label": "歌词优先，无则歌名" }
      ]
    },
    {
      "key": "openTrayKey",
      "type": "string",
      "label": "打开应用（绑定托盘）",
      "description": "面板「打开应用」左键该托盘",
      "default": "",
      "maxLength": 512,
      "uiHidden": true
    }
  ],
  "capabilities": [
    "storage",
    "network",
    "island.panel",
    "island.bar",
    "shortcuts",
    "media.keys"
  ],
  "permissions": {
    "network": ["127.0.0.1", "localhost"]
  }
}
