{
  "$schema": "../plugin.schema.json",
  "id": "com.window-hub.excalidraw",
  "name": "Excalidraw",
  "version": "1.0.8",
  "official": true,
  "logo": "icon.svg",
  "description": "快捷区先开较大弹窗，可向右拖拽加宽并记住大小；右下角图标窗口化，超过最大宽度自动全屏独立窗口。画布自动保存。首次需联网。",
  "entry": {
    "popup": "popup.html",
    "shortcuts": "shortcuts.html"
  },
  "slots": {
    "shortcuts": {
      "icon": "icon.svg",
      "label": "Excalidraw",
      "order": 28,
      "action": "popup.open",
      "manage": "none"
    }
  },
  "settings": [
    {
      "key": "popupWidth",
      "type": "number",
      "label": "弹窗宽度",
      "default": 480,
      "min": 360,
      "max": 720,
      "step": 10,
      "unit": "px"
    },
    {
      "key": "popupHeight",
      "type": "number",
      "label": "弹窗高度",
      "default": 640,
      "min": 480,
      "max": 900,
      "step": 10,
      "unit": "px"
    },
    {
      "key": "popupMaxWidth",
      "type": "number",
      "label": "弹窗最大宽度",
      "description": "向右拖拽超过此宽度时，自动关闭弹窗并以全屏系统窗口打开",
      "default": 720,
      "min": 480,
      "max": 1200,
      "step": 10,
      "unit": "px"
    }
  ],
  "capabilities": ["shortcuts", "storage", "popup"],
  "permissions": {
    "network": [
      "cdn.jsdelivr.net",
      "https://cdn.jsdelivr.net",
      "excalidraw.com",
      "https://excalidraw.com",
      "esm.sh",
      "https://esm.sh",
      "unpkg.com",
      "https://unpkg.com"
    ]
  }
}
