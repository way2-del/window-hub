{
  "$schema": "../plugin.schema.json",
  "id": "com.window-hub.lyrics",
  "name": "歌词",
  "version": "1.1.3",
  "official": true,
  "logo": "icon.svg",
  "description": "检测网易云桌面歌词并同步到灵动岛（轻量 api-lrc）。",
  "entry": {
    "shortcuts": "shortcuts.html",
    "panel": "panel.html"
  },
  "slots": {
    "shortcuts": {
      "icon": "icon.svg",
      "label": "歌词",
      "order": 8,
      "action": "command"
    },
    "island.bar": {
      "order": 15
    },
    "island.panel": {
      "defaultSize": { "w": 380, "h": 168 },
      "excludeFromPullContent": false
    }
  },
  "settings": [
    {
      "key": "requireDesktopLyrics",
      "type": "boolean",
      "label": "仅桌面歌词开启时占岛栏",
      "description": "未开网易云桌面歌词时清空岛栏，让位下一顺位（如天气）",
      "default": true
    },
    {
      "key": "showWhenIdle",
      "type": "boolean",
      "label": "未播放/未开桌面歌词时仍提示",
      "description": "关闭则直接让位天气等",
      "default": false
    },
    {
      "key": "preferLyric",
      "type": "boolean",
      "label": "优先显示歌词行",
      "description": "有歌词时显示当前行；短暂读空时会保持上一句",
      "default": true
    }
  ],
  "capabilities": ["storage", "island.panel", "island.bar", "shortcuts"]
}
